# ============================================================
# API KEYS — DO NOT SHARE OR COMMIT THIS FILE TO GIT
# Copy this file to .env and fill in your actual keys
# ============================================================
# cp .env.example .env   (Linux/Mac)
# copy .env.example .env  (Windows)

# Groq API Key — for ultra-fast LLM inference
# Get yours at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Cerebras API Key — backup LLM when Groq tokens expire
# https://cloud.cerebras.ai/
CEREBRAS_API_KEY=your_cerebras_api_key_here

# Pexels API Key — for high-quality presentation background images
# Get yours at: https://www.pexels.com/api/
PEXELS_API_KEY=your_pexels_api_key_here

# Gemini API Key — for Google AI Studio LLM
# Get yours at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# LLM Provider (for voice_assistant.py)
# Options: "gemini" or "openai_compatible"
LLM_PROVIDER=gemini

# OpenAI-compatible endpoint (only used if LLM_PROVIDER=openai_compatible)
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile