# ============================================================
# API KEYS — DO NOT SHARE OR COMMIT THIS FILE TO GIT
# Add .env to .gitignore to prevent accidental exposure
# ============================================================

# Groq API Key — for ultra-fast LLM inference
# Get yours at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Google Gemini API Keys (up to 3 for key rotation)
# Get yours at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_1_here
GEMINI_API_KEY_2=your_gemini_api_key_2_here
GEMINI_API_KEY_3=your_gemini_api_key_3_here

# Cerebras API Key — backup LLM when Groq tokens expire
# https://cloud.cerebras.ai/
CEREBRAS_API_KEY=your_cerebras_api_key_here

# Pexels API Key — for high-quality presentation background images
# Get yours at: https://www.pexels.com/api/
PEXELS_API_KEY=your_pexels_api_key_here

# Gemini Model Name (optional override)
# Default: gemini-1.5-flash
# Options: gemini-2.0-flash-exp, gemini-1.5-pro, gemini-2.5-pro-exp-03-25
GEMINI_MODEL=gemini-1.5-flash

# Context Cache TTL in seconds (default: 7200 = 2 hours)
CACHE_TTL_SECONDS=7200